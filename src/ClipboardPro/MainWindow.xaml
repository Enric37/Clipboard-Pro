<Window x:Class="ClipboardPro.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="clr-namespace:ClipboardPro.Models" Width="780" Height="590" MinWidth="620" MinHeight="440" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False" Deactivated="Window_Deactivated" KeyDown="Window_KeyDown">
  <Border Margin="10" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="15" SnapsToDevicePixels="True">
    <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity=".32" Color="#000000"/></Border.Effect>
    <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="45"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
      <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
        <Image Width="28" Height="28" VerticalAlignment="Center" Source="/Assets/ClipboardPro-512.png" SnapsToDevicePixels="True"/>
        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="10,0"><Grid><TextBlock Text="⌕" Foreground="{DynamicResource MutedBrush}" FontSize="22" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" Margin="28,0,0,0" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="Buscar (Ctrl+F)"/><TextBlock x:Name="SearchHint" Text="Buscar en tu portapapeles..." Foreground="{DynamicResource MutedBrush}" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid></Border>
        <Button Grid.Column="2" Content="⚙" FontSize="17" Click="Settings_Click" ToolTip="Configuración"/>
      </Grid>
      <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="AllFilter" Style="{StaticResource PillButton}" Content="Todo" Tag="" Click="Filter_Click"/><Button Style="{StaticResource PillButton}" Content="Texto" Tag="Text" Click="Filter_Click"/><Button Style="{StaticResource PillButton}" Content="Imágenes" Tag="Image" Click="Filter_Click"/><Button Style="{StaticResource PillButton}" Content="Archivos" Tag="Files" Click="Filter_Click"/><Button Style="{StaticResource PillButton}" Content="Enlaces" Tag="Url" Click="Filter_Click"/><Button Style="{StaticResource PillButton}" Content="Código" Tag="Code" Click="Filter_Click"/><Button Style="{StaticResource PillButton}" Content="★ Favoritos" Tag="Favorites" Click="Filter_Click"/></StackPanel>
      <Grid Grid.Row="2"><ListBox x:Name="ClipList" SelectionChanged="ClipList_SelectionChanged" MouseDoubleClick="ClipList_MouseDoubleClick" ScrollViewer.ScrollChanged="ClipList_ScrollChanged"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate DataType="{x:Type m:ClipItem}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><Border Width="29" Height="29" CornerRadius="8" Background="#167C5CFF" VerticalAlignment="Top"><TextBlock Text="{Binding TypeLabel}" FontSize="7" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,8,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Preview}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="34"/><TextBlock Text="{Binding SourceProcess}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding RelativeTime}" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Right"/><TextBlock Text="★" Foreground="#FFE9C46A" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Right"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate><ListBox.ContextMenu><ContextMenu><MenuItem Header="Copiar" Click="Copy_Click"/><MenuItem Header="Pegar" Click="Paste_Click"/><Separator/><MenuItem Header="Favorito" Click="Favorite_Click"/><MenuItem Header="Fijar" Click="Pin_Click"/><MenuItem Header="Editar" Click="Edit_Click"/><MenuItem Header="Eliminar" Click="Delete_Click"/></ContextMenu></ListBox.ContextMenu></ListBox><StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="◌" FontSize="44" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/><TextBlock Text="No has copiado nada todavía." FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/><TextBlock Text="Todo lo que copies aparecerá aquí." Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Grid>
      <Grid Grid.Row="3" VerticalAlignment="Bottom"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="↑↓ navegar · Enter pegar · Esc cerrar" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Copiar" Click="Copy_Click"/><Button Content="★" Click="Favorite_Click" ToolTip="Favorito"/><Button Content="•••" Click="More_Click" ToolTip="Más acciones"/></StackPanel></Grid>
    </Grid>
  </Border>
</Window>
