<Window x:Class="ClipboardPro.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Configuración — Clipboard Pro" Width="760" Height="560" WindowStartupLocation="CenterOwner" Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <StackPanel><TextBlock Text="CLIPBOARD PRO" Foreground="#FF9E8DFF" FontWeight="Bold" FontSize="11" Margin="8,0,0,18"/><Button Content="General" HorizontalContentAlignment="Left" Click="General_Click"/><Button Content="Historial" HorizontalContentAlignment="Left" Click="History_Click"/><Button Content="Privacidad" HorizontalContentAlignment="Left" Click="Privacy_Click"/><Button Content="Almacenamiento" HorizontalContentAlignment="Left" Click="Storage_Click"/><Button Content="Acerca de" HorizontalContentAlignment="Left" Click="About_Click"/></StackPanel>
  <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="24"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ContentPanel"/></ScrollViewer></Border>
 </Grid>
</Window>
