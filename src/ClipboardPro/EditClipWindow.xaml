<Window x:Class="ClipboardPro.EditClipWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Editar clip" Width="560" Height="330" WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Editar texto" FontSize="16" FontWeight="SemiBold"/><TextBox x:Name="Editor" Grid.Row="1" Margin="0,14" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{DynamicResource BgBrush}" Padding="12"/><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" IsCancel="True"/><Button Content="Guardar" IsDefault="True" Click="Save_Click" Background="{DynamicResource AccentBrush}"/></StackPanel></Grid>
</Window>
